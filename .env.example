# Optional API keys. The app works without them using free fallbacks.

# Premium market data (any one is enough; adapter auto-selects what's set)
POLYGON_API_KEY=
ALPACA_API_KEY=
ALPACA_API_SECRET=
TRADIER_TOKEN=
FINNHUB_API_KEY=

# News
NEWSAPI_KEY=
BENZINGA_API_KEY=

# Social sentiment
TWITTER_BEARER_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=trading101/0.1
STOCKTWITS_TOKEN=

# Telegram bot (optional — enables /scan, /chart, /news, /alerts, /stats)
# 1. Talk to @BotFather on Telegram -> /newbot  -> paste the HTTP token below.
# 2. Start a chat with your new bot, then visit
#    https://api.telegram.org/bot<TOKEN>/getUpdates to find your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Engine tuning
TRADING101_UNIVERSE=AAPL,MSFT,NVDA,TSLA,AMD,META,GOOGL,AMZN,NFLX,AVGO,SMCI,PLTR,COIN,MARA,RIOT,SOFI,GME,AMC,ARM,SNOW
TRADING101_MIN_CONFIDENCE=medium
TRADING101_LOG_LEVEL=INFO
